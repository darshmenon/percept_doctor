<?xml version="1.0"?>
<package format="3">
  <name>percept_doctor</name>
  <version>0.1.0</version>
  <description>Attach to a running ROS 2 robot and report camera, depth and point cloud health. Read-only.</description>
  <maintainer email="darshmenon02@gmail.com">darshmenon</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
